<!-- Remaining manager endpoints — summarised -->
<mxCell id="mgr_rest" value="Remaining Manager Endpoints — Pattern Summary" style="text;fontSize=14;fontStyle=1;fontColor=#b85450;" vertex="1" parent="1"><mxGeometry x="40" y="3770" width="460" height="30" as="geometry"/></mxCell>

<mxCell id="mgr1" value="PUT /accounts/:id/unfreeze — Same as freeze but sets status = ACTIVE, creates AccountFreeze with status LIFTED. Bad paths: 403 not manager, 404 not found, 409 not currently frozen." style="text;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="3808" width="700" height="30" as="geometry"/></mxCell>

<mxCell id="mgr2" value="PUT /wallets/:id/freeze — Same pattern but targets Wallet entity. Sets wallet status = FROZEN, creates WalletFreeze record. Does not freeze other wallets. Bad paths same as account freeze." style="text;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="3845" width="700" height="30" as="geometry"/></mxCell>

<mxCell id="mgr3" value="PUT /wallets/:id/unfreeze — Same as wallet freeze but sets status = ACTIVE, lifts WalletFreeze record." style="text;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="3882" width="600" height="22" as="geometry"/></mxCell>

<mxCell id="mgr4" value="GET /transactions/all — Manager only. Fetches all transactions across all wallets. Paginated. 200 OK { transactions, total, page }. Bad paths: 401, 403 not manager." style="text;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="3912" width="700" height="30" as="geometry"/></mxCell>

<mxCell id="mgr5" value="GET /transactions/flagged — Manager only. Fetches all FraudFlag records with status OPEN. 200 OK { flags: [...] }. Bad paths: 401, 403 not manager." style="text;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="3949" width="700" height="30" as="geometry"/></mxCell>

<mxCell id="mgr6" value="PUT /fraud/:id/review {decision: REVIEWED | DISMISSED} — Manager reviews fraud flag. Updates FraudFlag status. 200 OK. Bad paths: 401, 403, 404 flag not found, 400 invalid decision." style="text;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="3986" width="800" height="30" as="geometry"/></mxCell>

