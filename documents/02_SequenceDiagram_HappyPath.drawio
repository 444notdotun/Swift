<!-- Step 1: Client → TransactionService -->
<mxCell id="s1" value="POST /transfer (JWT + body)" style="endArrow=block;startArrow=none;strokeColor=#2563EB;fontStyle=1;fontSize=11;" edge="1" parent="1"><mxGeometry x="120" y="160" relative="0" as="geometry"><Array as="points"><mxPoint x="120" y="160"/><mxPoint x="335" y="160"/></Array></mxGeometry></mxCell>

