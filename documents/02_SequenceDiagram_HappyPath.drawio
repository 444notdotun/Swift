<mxCell id="s2" value="SETNX idempotency key (60s TTL)" style="endArrow=block;strokeColor=#b85450;fontSize=11;" edge="1" parent="1"><mxGeometry x="335" y="200" relative="0" as="geometry"><Array as="points"><mxPoint x="335" y="200"/><mxPoint x="540" y="200"/></Array></mxGeometry></mxCell>
