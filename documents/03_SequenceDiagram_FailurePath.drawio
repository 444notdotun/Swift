<!-- Step 8: Emit DebitReversed -->
<mxCell id="s8" value="Emit: DebitReversed event" style="endArrow=block;strokeColor=#9673a6;fontSize=11;" edge="1" parent="1"><mxGeometry x="740" y="495" relative="0" as="geometry"><Array as="points"><mxPoint x="740" y="495"/><mxPoint x="940" y="495"/></Array></mxGeometry></mxCell>
<mxCell id="s8r" value="gRPC: REVERSED" style="endArrow=block;strokeColor=#FF6600;fontSize=11;dashed=1;" edge="1" parent="1"><mxGeometry x="740" y="515" relative="0" as="geometry"><Array as="points"><mxPoint x="740" y="515"/><mxPoint x="335" y="515"/></Array></mxGeometry></mxCell>

<!-- Step 9: Mark REVERSED + save failure -->
<mxCell id="s9a" value="Mark Transaction: REVERSED — save TransactionFailure record" style="text;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;" vertex="1" parent="1"><mxGeometry x="240" y="540" width="340" height="22" as="geometry"/></mxCell>

<!-- Step 10: Emit TransactionReversed -->
<mxCell id="s10" value="Emit: TransactionReversed" style="endArrow=block;strokeColor=#9673a6;fontStyle=1;fontSize=11;" edge="1" parent="1"><mxGeometry x="335" y="578" relative="0" as="geometry"><Array as="points"><mxPoint x="335" y="578"/><mxPoint x="940" y="578"/></Array></mxGeometry></mxCell>

<!-- Step 11: Update Redis — restore sender balance -->
<mxCell id="s11" value="Restore sender balance in Redis" style="endArrow=block;strokeColor=#b85450;fontSize=11;" edge="1" parent="1"><mxGeometry x="940" y="608" relative="0" as="geometry"><Array as="points"><mxPoint x="940" y="608"/><mxPoint x="540" y="608"/></Array></mxGeometry></mxCell>

<!-- Step 12: Notify sender -->
<mxCell id="s12" value="SMS + Email: Transfer failed — money reversed" style="endArrow=block;strokeColor=#6c8ebf;fontSize=11;" edge="1" parent="1"><mxGeometry x="940" y="638" relative="0" as="geometry"><Array as="points"><mxPoint x="940" y="638"/><mxPoint x="1145" y="638"/></Array></mxGeometry></mxCell>

<!-- Step 13: Response -->
<mxCell id="s13" value="409 CONFLICT — { message: Transfer failed, money reversed }" style="endArrow=block;strokeColor=#b85450;fontStyle=1;fontSize=11;dashed=1;" edge="1" parent="1"><mxGeometry x="335" y="678" relative="0" as="geometry"><Array as="points"><mxPoint x="335" y="678"/><mxPoint x="120" y="678"/></Array></mxGeometry></mxCell>

<!-- Transient failure note -->
<mxCell id="note1" value="NOTE: If failure is transient (gRPC timeout, service down)&#xa;→ Redis key expires naturally after 60s&#xa;→ Return 503 — user retries after window" style="text;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;" vertex="1" parent="1"><mxGeometry x="60" y="730" width="400" height="60" as="geometry"/></mxCell>

<!-- Permanent failure note -->
<mxCell id="note2" value="NOTE: If failure is permanent (WalletFrozenException, InsufficientFundsException)&#xa;→ Delete Redis key immediately&#xa;→ Return 400 with clear error message to user" style="text;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=left;" vertex="1" parent="1"><mxGeometry x="60" y="805" width="500" height="60" as="geometry"/></mxCell>

